# Copy to .env.local for local dev. NEVER commit real keys (.env* is gitignored).

# Supabase project URL (Project Settings -> API). Public — shipped to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon/publishable key. Public — safe for browsers, gated by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role/secret key. SERVER ONLY — bypasses RLS. Never expose to the
# client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
