{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(npm install:*)",
      "Bash(npx supabase:*)",
      "Bash(npx tsx:*)",
      "Bash(node:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Read(.env.local)",
      "Read(.env*.local)"
    ]
  }
}
